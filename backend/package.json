    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
