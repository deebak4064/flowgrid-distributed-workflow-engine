{
  "name": "flowgrid-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "api": "FLOWGRID_ROLE=api node src/main.ts",
    "scheduler": "FLOWGRID_ROLE=scheduler node src/main.ts",
    "worker": "FLOWGRID_ROLE=worker node src/main.ts",
